# Copy to .env and fill in. .env is git-ignored: never commit real keys.
#   cp .env.example .env

# Gnani (Vachana) speech API key, used for voice in Phase 4.
# Sent only as the X-API-Key-ID header to Gnani; never logged.
GNANI_API_KEY=

# Optional LLM (Phase 6) for answering questions from your files and for unclear
# commands. Off unless you run: python -m zachary.cli set llm_enabled true
# Only the question and a few short passages are sent; never whole files. Never logged.
# Fill in the key for the provider you use (python -m zachary.cli set llm_provider ...):
GROQ_API_KEY=        # default, free tier: https://console.groq.com/keys
GEMINI_API_KEY=      # free tier: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=   # paid: https://console.anthropic.com
